<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>KaizenIO.Jev</PackageId>
    <Version>0.1.0</Version>
    <Description>.NET client for the Jev API (POST /v1/systemone): ask noul (yes/no), choice and score questions about a piece of state in one parallel request.</Description>
    <PackageTags>jev;ai;classification;client;kaizen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kaizen-hq/Kaizen.Jev</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kaizen-hq/Kaizen.Jev</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Kaizen.Jev.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
</Project>
